# Controle de versao (nao entra na imagem).
.git

# Testes e documentacao de projeto (nao sao runtime).
tests/
docs/

# Config/segredos e ambiente local (variaveis vem do compose/--env-file).
.env

# Ambiente virtual e cache Python — reinstalado via requirements.txt.
venv/
__pycache__/
*.pyc
.pytest_cache/

# Dados locais gerados em runtime (indice FAISS, etc.) — nao sao insumo de
# build; docs_fontes/ (transcricao do Doc1) e os Doc2-6.pdf SAO insumo e
# permanecem fora deste arquivo, so o Doc1.pdf original (rasterizado, nao
# usado pela ingestao) e a prova em si ficam de fora explicitamente abaixo.
data_local/

# PDFs que nao sao insumo do bootstrap: Doc1.pdf foi substituido pela
# transcricao em docs_fontes/doc1_rolamentos.md; o PDF da prova nunca e
# usado pela aplicacao. Doc2.pdf..Doc6.pdf permanecem (necessarios ao RAG,
# copiados explicitamente nos Dockerfiles).
