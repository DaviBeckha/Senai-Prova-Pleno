# Database configuration
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/manutencao

# LLM Mode: "offline" or "online"
# LLM_MODE=offline

# Ollama configuration (for offline mode)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT=300
# OLLAMA_NUM_CTX=8192

# OpenAI configuration (for online mode)
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-5.6-luna

# Embedding model
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_DIM=768

# Data files and directories
# DATA_FILE=banner.xlsx
# FAISS_DIR=data_local/faiss

# Recuperacao de evidencia (RAG)
# RAG_K: trechos recuperados por familia.
# RAG_MIN_SCORE: cosseno minimo para um trecho contar como evidencia. Os
#   embeddings sao normalizados, entao 0..1. O default 0.82 foi MEDIDO contra
#   os documentos do projeto: o E5 comprime cossenos para cima (consultas fora
#   do dominio chegam a 0.84), e 0.82 preserva 100% da evidencia relevante
#   descartando ~90% do ruido. Acima de 0.85 comeca a perder evidencia real.
# RAG_COMPLETE_MAX_CHARS: teto de caracteres por familia em pedidos de
#   "procedimento completo"; o excedente vira limitacao declarada na resposta.
# RAG_K=4
# RAG_MIN_SCORE=0.82
# RAG_COMPLETE_MAX_CHARS=12000
